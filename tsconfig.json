{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": [
      "google-apps-script",
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}
