{
  "key": "SUBMITTAL_ARCH",
  "label": "Submittal Arch",
  "name": "Submittal Architecture",
  "identity": {
    "format": "${section}-${number}-${revision}-${date}",
    "groupFormat": "${section}-${number}",
    "revisionGroupFormat": "${section}-${number}-${revision}"
  },
  "fields": [
    {
      "key": "section",
      "label": "Section",
      "type": "string",
      "required": false,
      "description": "CSI Section # (6 digits)",
      "header": "Section",
      "keyNormalizationRule": "code"
    },
    {
      "key": "number",
      "label": "Number",
      "type": "string",
      "required": false,
      "description": "Submittal #",
      "header": "Number"
    },
    {
      "key": "revision",
      "label": "Revision",
      "type": "string",
      "required": false,
      "description": "Revision #",
      "defaultValue": "0",
      "header": "Revision"
    },
    {
      "key": "title",
      "label": "Title",
      "type": "string",
      "required": true,
      "header": "Title"
    },
    {
      "key": "date",
      "label": "Date",
      "type": "date",
      "required": true,
      "description": "Date (YYMMDD)",
      "header": "Date"
    },
    {
      "key": "contact",
      "label": "Contact",
      "type": "enum",
      "required": true,
      "header": "Contact",
      "picklistSource": {
        "supportDataKey": "Contacts_Arch",
        "valueColumnKey": "code",
        "displayColumnKey": "name"
      }
    },
    {
      "key": "action",
      "label": "Action",
      "type": "enum",
      "required": true,
      "header": "Action",
      "picklistSource": {
        "supportDataKey": "Actions",
        "valueColumnKey": "code",
        "displayColumnKey": "name"
      }
    },
    {
      "key": "incomingRouting",
      "label": "Incoming Routing",
      "type": "enum",
      "required": false,
      "header": "Incoming Routing",
      "picklistSource": {
        "supportDataKey": "Contacts_Arch",
        "valueColumnKey": "code",
        "displayColumnKey": "name"
      }
    },
    {
      "key": "notes",
      "label": "Notes",
      "type": "multiline",
      "required": false,
      "description": "Notes",
      "header": "Notes"
    },
    {
      "key": "calcFileName",
      "label": "Calc File Name",
      "type": "string",
      "isCalculated": true,
      "header": "Calc File Name",
      "calcFormat": "${section}-${number}-${revision}"
    }
  ],
  "storage": [
    {
      "type": "drive",
      "rootFolderSearchTerms": [
        "Submittals",
        "Submittal"
      ],
      "projectSearchTerms": [
        "Submittals",
        "Submittal"
      ],
      "closedRootFolderName": "Closed",
      "closedSubfolderFormat": "Closed/${section}",
      "filenamePrefix": "_",
      "filenameFormat": "${calcFileName}"
    }
  ],
  "workflows": [
    {
      "context": "GoogleDrive",
